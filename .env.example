# Copia este archivo como .env y cambia los valores. .env no se sube al repositorio.
# Lo leen tanto docker compose (contenedor de Postgres) como Spring (conexión de la app).

POSTGRES_USER=library
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=library
POSTGRES_HOST=localhost
# 5433 para no chocar con un Postgres instalado localmente en 5432
POSTGRES_PORT=5433

# Almacenamiento de imágenes: local o s3
STORAGE_TYPE=local
# Solo si STORAGE_TYPE=s3 (las credenciales de AWS van en AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY o ~/.aws)
# S3_BUCKET=
# AWS_REGION=
